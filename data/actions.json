      "cost": 0,
      "prerequisites": [
        {"state": "player_knowledge", "key": "preserved_recording_once", "equals": true}
      ],
      "effects": [
        {"target": "world_state", "operation": "SET", "key": "final_soundprint_available", "value": true}
